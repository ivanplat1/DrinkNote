{
    "expo": {
    "name": "DrinkNote",
    "slug": "DrinkNote",
    "scheme": "drinknote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.drinknote.app",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DrinkNote",
      "shortName": "DrinkNote",
      "lang": "ru",
      "scope": "/DrinkNote/",
      "themeColor": "#1a1a1a",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/DrinkNote/",
      "bundler": "metro",
      "baseUrl": "/DrinkNote"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "Серия без алкоголя",
              "minHeight": "120dp",
              "minWidth": "300dp",
              "description": "Текущая серия дней без алкоголя",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Favorites",
              "label": "Напитки из избранного",
              "minHeight": "200dp",
              "minWidth": "360dp",
              "description": "Быстрое добавление напитка из избранного",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1f026970-5d72-4828-915f-6b0955bbcaf1"
      }
    }
  }
}
