{
  "expo": {
    "name": "DrinkNote",
    "slug": "DrinkNote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.drinknote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DrinkNote",
      "shortName": "DrinkNote",
      "lang": "ru",
      "scope": "/DrinkNote/",
      "themeColor": "#1a1a1a",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/DrinkNote/",
      "bundler": "metro",
      "baseUrl": "/DrinkNote"
    },
    "plugins": [
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "1f026970-5d72-4828-915f-6b0955bbcaf1"
      }
    }
  }
}
